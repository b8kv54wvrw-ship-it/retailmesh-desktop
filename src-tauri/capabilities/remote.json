{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "remote-app",
  "description": "Allow the RetailMesh web app (loaded remotely) to send native notifications",
  "remote": {
    "urls": ["https://retailmesh.co.za"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default"
  ]
}
